<?xml version="1.0" encoding="utf-8"?><!--suppress DeprecatedClassUsageInspection -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceScreen android:title="@string/open_source_license">
        <Preference
            android:summary="GNU General Public License v3.0"
            android:title="Morphe Patcher">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/MorpheApp/morphe-patcher" />
        </Preference>
        <Preference
            android:summary="LGPL-3.0 license, LuckyPray"
            android:title="DexKit">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/LuckyPray/DexKit" />
        </Preference>
        <Preference
            android:layout_height="wrap_content"
            android:summary="Apache License 2.0, Kotlin Team"
            android:title="Kotlin">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://kotlinlang.org/" />
        </Preference>
        <Preference
            android:layout_height="wrap_content"
            android:summary="GNU General Public License v3.0, Copyright (C) 2021 LSPosed Contributors"
            android:title="LSPosed">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/LSPosed/LSPosed" />
        </Preference>
    </PreferenceScreen>
</PreferenceScreen>
